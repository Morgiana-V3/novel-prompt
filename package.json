{
  "name": "novel-prompt",
  "version": "0.4.0",
  "description": "NovelAI 提示词比对 / 搜索 / AI 优化桌面工具",
  "main": "./out/main/index.js",
  "author": "holyxie",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "data:export": "node scripts/export-data.mjs",
    "mcp:smoke": "electron-vite build && node scripts/mcp-smoke.mjs",
    "screenshots": "electron-vite build && electron . --screenshots=docs/screenshots",
    "screenshots:ai": "electron-vite build && electron . --screenshots=docs/screenshots --screenshots-ai",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.holyxie.novelprompt",
    "productName": "NovelPrompt",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "default-data",
        "to": "default-data",
        "filter": [
          "*.json.gz",
          "manifest.json"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "scripts/mcp-proxy.cjs",
        "to": "mcp-proxy.cjs"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NovelPrompt-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NovelPrompt-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "pinyin-pro": "^3.29.5",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
