{
  "name": "novel-prompt",
  "version": "0.8.0",
  "description": "NovelAI 提示词比对 / 搜索 / AI 优化桌面工具",
  "main": "./out/main/index.js",
  "author": "holyxie",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "skills:smoke": "electron tests/integration/skill-packages-smoke.cjs",
    "prompt:smoke": "electron-vite build && electron tests/e2e/prompt-smoke.cjs",
    "tasks:smoke": "electron-vite build && electron tests/e2e/tasks-smoke.cjs",
    "tasks:preview": "electron-vite build && electron tests/e2e/tasks-smoke.cjs --preview",
    "update:smoke": "electron tests/integration/update-smoke.cjs",
    "desktop:smoke": "electron-vite build && electron tests/e2e/desktop-mcp-smoke.cjs",
    "desktop:lifecycle-smoke": "electron tests/e2e/desktop-lifecycle-smoke.cjs",
    "mcp:launch-smoke": "node tests/unit/mcp-launch-smoke.cjs",
    "mcp:relay-smoke": "node tests/integration/mcp-relay-smoke.cjs",
    "mcp:recovery-smoke": "electron tests/integration/mcp-recovery-smoke.cjs",
    "mcp:context-smoke": "electron tests/integration/mcp-context-smoke.cjs",
    "mcp:performance-smoke": "electron tests/integration/mcp-performance-smoke.cjs",
    "mcp:index-smoke": "electron tests/integration/mcp-index-smoke.cjs",
    "mcp:preview-cache-smoke": "electron tests/integration/mcp-preview-cache-smoke.cjs",
    "mcp:host-smoke": "electron-vite build && node tests/e2e/mcp-host-smoke.mjs",
    "startup:smoke": "electron-vite build && node tests/e2e/workspace-startup-smoke.mjs",
    "isolation:smoke": "electron-vite build && node tests/e2e/environment-isolation-smoke.mjs",
    "data:export": "node scripts/export-data.mjs",
    "mcp:smoke": "electron-vite build && node tests/integration/mcp-smoke.mjs",
    "inpaint:smoke": "electron-vite build && electron tests/e2e/inpaint-smoke.cjs",
    "inpaint:mcp-smoke": "electron tests/integration/inpaint-mcp-smoke.cjs",
    "pages:smoke": "electron-vite build && electron tests/e2e/page-workspace-smoke.cjs",
    "retention:smoke": "electron tests/integration/retention-smoke.cjs",
    "workspace:cleanup-smoke": "electron tests/integration/workspace-cleanup-smoke.cjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:ai": "node scripts/capture-screenshots.mjs --ai",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "check:quick": "node scripts/check.mjs quick",
    "check:full": "node scripts/check.mjs full",
    "format:check": "prettier --check \"src/**/*.{ts,cts,vue,css,less,cjs}\" \"scripts/*.{mjs,cjs}\" \"tests/**/*.{mjs,cjs}\" \"*.config.{ts,mjs}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,cts,vue,css,less,cjs}\" \"scripts/*.{mjs,cjs}\" \"tests/**/*.{mjs,cjs}\" \"*.config.{ts,mjs}\"",
    "lint:check": "eslint src scripts tests --max-warnings 0",
    "lint:fix": "eslint src scripts tests --fix",
    "style:check": "stylelint \"src/renderer/src/**/*.{css,less,vue}\"",
    "style:fix": "stylelint \"src/renderer/src/**/*.{css,less,vue}\" --fix",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "acceptance:build": "node scripts/build-acceptance-packages.mjs"
  },
  "build": {
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**",
      "node_modules/@img/**"
    ],
    "appId": "com.holyxie.novelprompt",
    "productName": "NovelPrompt",
    "publish": [
      {
        "provider": "github",
        "owner": "Morgiana-V3",
        "repo": "novel-prompt",
        "releaseType": "draft"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!**/TODO.md"
    ],
    "extraResources": [
      {
        "from": "skill-templates",
        "to": "skill-templates"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "default-data",
        "to": "default-data",
        "filter": [
          "*.json.gz",
          "manifest.json"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "src/runtime/mcp-proxy.cjs",
        "to": "mcp-proxy.cjs"
      },
      {
        "from": "src/runtime/runtime-profile.cjs",
        "to": "runtime-profile.cjs"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NovelPrompt-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NovelPrompt-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.11",
    "markdown-it": "^15.0.3",
    "onnxruntime-node": "^1.31.1",
    "pinyin-pro": "^3.29.5",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "less": "^4.9.1",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
