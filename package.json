{
  "name": "novel-prompt",
  "version": "0.6.0",
  "description": "NovelAI 提示词比对 / 搜索 / AI 优化桌面工具",
  "main": "./out/main/index.js",
  "author": "holyxie",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prompt:smoke": "electron-vite build && electron scripts/prompt-smoke.cjs",
    "tasks:smoke": "electron-vite build && electron scripts/tasks-smoke.cjs",
    "tasks:preview": "electron-vite build && electron scripts/tasks-smoke.cjs --preview",
    "update:smoke": "electron scripts/update-smoke.cjs",
    "desktop:smoke": "electron-vite build && electron scripts/desktop-mcp-smoke.cjs",
    "desktop:lifecycle-smoke": "electron scripts/desktop-lifecycle-smoke.cjs",
    "mcp:launch-smoke": "node scripts/mcp-launch-smoke.cjs",
    "mcp:relay-smoke": "node scripts/mcp-relay-smoke.cjs",
    "mcp:recovery-smoke": "electron scripts/mcp-recovery-smoke.cjs",
    "mcp:context-smoke": "electron scripts/mcp-context-smoke.cjs",
    "mcp:performance-smoke": "electron scripts/mcp-performance-smoke.cjs",
    "mcp:index-smoke": "electron scripts/mcp-index-smoke.cjs",
    "mcp:preview-cache-smoke": "electron scripts/mcp-preview-cache-smoke.cjs",
    "mcp:host-smoke": "electron-vite build && node scripts/mcp-host-smoke.mjs",
    "startup:smoke": "electron-vite build && node scripts/workspace-startup-smoke.mjs",
    "isolation:smoke": "electron-vite build && node scripts/environment-isolation-smoke.mjs",
    "data:export": "node scripts/export-data.mjs",
    "mcp:smoke": "electron-vite build && node scripts/mcp-smoke.mjs",
    "inpaint:smoke": "electron-vite build && electron scripts/inpaint-smoke.cjs",
    "inpaint:mcp-smoke": "electron scripts/inpaint-mcp-smoke.cjs",
    "pages:smoke": "electron-vite build && electron scripts/page-workspace-smoke.cjs",
    "retention:smoke": "electron scripts/retention-smoke.cjs",
    "workspace:cleanup-smoke": "electron scripts/workspace-cleanup-smoke.cjs",
    "screenshots": "electron-vite build && electron . --screenshots=release/screenshots",
    "screenshots:ai": "electron-vite build && electron . --screenshots=release/screenshots --screenshots-ai",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.holyxie.novelprompt",
    "productName": "NovelPrompt",
    "publish": [
      {
        "provider": "github",
        "owner": "Morgiana-V3",
        "repo": "novel-prompt",
        "releaseType": "draft"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "default-data",
        "to": "default-data",
        "filter": [
          "*.json.gz",
          "manifest.json"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "scripts/mcp-proxy.cjs",
        "to": "mcp-proxy.cjs"
      },
      {
        "from": "scripts/runtime-profile.cjs",
        "to": "runtime-profile.cjs"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NovelPrompt-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NovelPrompt-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "markdown-it": "^15.0.3",
    "pinyin-pro": "^3.29.5",
    "pngjs": "^7.0.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
